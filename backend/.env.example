# Caminho do JSON da conta de serviço (nunca no Git). Na Vercel use FIREBASE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

FLASK_SECRET_KEY=
FLASK_ENV=development
SESSION_COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000

# Segredo compartilhado com o firmware de TESTE no Wokwi (gere com: python -c "import secrets;print(secrets.token_urlsafe(32))")
DEVICE_SHARED_SECRET=

# URL pública HTTPS (ngrok/cloudflared) - usada nas back_urls e no webhook do Mercado Pago
APP_BASE_URL=https://SEU-TUNEL.ngrok-free.app

# Mercado Pago: credenciais de TESTE da sua aplicação
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Política de tarifa (opcional)
ENTRY_TOLERANCE_MINUTES=15
EXIT_GRACE_MINUTES=10
# Para agendar a expiração de reservas (rota /api/admin/expire-pending)
CRON_SECRET=
